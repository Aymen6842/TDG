@startuml
!theme plain
skinparam backgroundColor transparent
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName "Helvetica"
skinparam classAttributeIconSize 0
skinparam ArrowColor #33475b
skinparam class {
  BackgroundColor #FBFCFE
  BorderColor #33475b
  ArrowColor #33475b
}

package "Identity & Access (Sprint 1)" {

  enum UserType <<enum>> {
    CEO
    CTO
    CMO
    .. 31 roles ..
    PendingApproval
  }

  class User {
    +id : UUID
    +email : String <<unique>>
    +phone : String <<unique>>
    +name : String
    +unaccentedName : String
    -password : String <<bcrypt>>
    +isActive : Boolean
  }

  class Role {
    +id : UUID
    +type : UserType
    -userId : UUID
  }

  class RefreshToken {
    +token : String <<PK = JWT>>
    -userId : UUID
    +createdAt : DateTime
  }

  class ResetPasswordCode {
    +id : UUID
    +code : String
    -userId : UUID <<unique>>
    +expiredAt : DateTime
  }

  class Team {
    +id : UUID
    +name : String <<unique>>
    +unaccentedName : String
  }

  class UserTeam {
    +id : UUID
    -userId : UUID
    -teamId : UUID
    +isManager : Boolean
  }

  class UserManager <<dormant>> {
    +id : UUID
    -userId : UUID
    -managerId : UUID
  }
}

package "Projects & Membership (Sprint 2)" {

  enum BusinessUnit <<enum>> #LightYellow {
    TawerDev
    TawerCreative
  }
  enum ProjectStatus <<enum>> #LightYellow {
    Pending
    Running
    Stopped
    Completed
  }
  enum ProjectType <<enum>> #LightYellow {
    AGILE
    FREESTYLE
  }
  enum InvitationStatus <<enum>> #LightYellow {
    PENDING
    ACCEPTED
    EXPIRED
    CANCELLED
  }

  class Project #LightYellow {
    +id : UUID
    +businessUnit : BusinessUnit
    +status : ProjectStatus
    +projectType : ProjectType
    +paid : Boolean
    +isArchived : Boolean
    +displayOrder : Integer
    +kanbanSettings : Json
    -createdById : UUID
  }

  class ProjectContent #LightYellow {
    +id : UUID
    -projectId : UUID
    +name : String
    +unaccentedName : String
    +language : Language
  }

  class ProjectMember #LightYellow {
    +id : UUID
    -projectId : UUID
    -userId : UUID
    +isManager : Boolean
    +hourlyRate : Decimal
  }

  class ProjectInvitation #LightYellow {
    +id : UUID
    -projectId : UUID
    +email : String
    +token : String <<unique>>
    +status : InvitationStatus
    +isManager : Boolean
    +expiresAt : DateTime
  }
}

User "1" --> "0..*" Role : has
User "1" --> "0..*" RefreshToken : issues
User "1" --> "0..1" ResetPasswordCode : has
User "1" --> "0..*" UserTeam : "member of"
Team "1" --> "0..*" UserTeam : "has members"
User "1" ..> "0..*" UserManager : "manages (unused)"
Role ..> UserType : type

User "1" --> "0..*" Project : creates
Project "1" --> "1..*" ProjectContent : "has (i18n)"
Project "1" --> "1..*" ProjectMember : "has team"
Project "1" --> "0..*" ProjectInvitation : "has invites"
User "1" --> "0..*" ProjectMember : "member of"
User "1" --> "0..*" ProjectInvitation : "invited by"
Project ..> BusinessUnit
Project ..> ProjectType
ProjectInvitation ..> InvitationStatus
@enduml
