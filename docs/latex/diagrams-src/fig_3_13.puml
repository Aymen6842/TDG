@startuml
!theme plain
skinparam backgroundColor transparent
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName "Helvetica"
skinparam classAttributeIconSize 0
skinparam ArrowColor #33475b
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #FBFCFE
  BorderColor #33475b
}
left to right direction

actor "Product Owner" as PO
actor "Project Manager" as PM
actor "Scrum Master" as SM
actor "Assignee /\nDeveloper" as Dev

rectangle "Tawer Management — Sprint 3" {
  usecase "Manage epics" as UC_Epic
  usecase "Manage milestones" as UC_Miles
  usecase "Create & manage tasks\n(type, priority, dependencies)" as UC_Task
  usecase "Groom & reorder\nbacklog" as UC_Backlog
  usecase "Configure kanban\n(columns + WIP)" as UC_Kanban
  usecase "View analytics\n(burndown / velocity / Gantt)" as UC_Analytics
  usecase "Manage sprint lifecycle\n(plan, assign, start, complete)" as UC_Sprint
  usecase "Move task in kanban" as UC_Move
  usecase "Collaborate on tasks\n(comments, time, @mentions)" as UC_Collab
}

PO --> UC_Epic
PO --> UC_Miles
PO --> UC_Task
PO --> UC_Backlog

PM --> UC_Miles
PM --> UC_Task
PM --> UC_Kanban
PM --> UC_Backlog
PM --> UC_Analytics

SM --> UC_Backlog
SM --> UC_Sprint

Dev --> UC_Move
Dev --> UC_Collab
@enduml
