{
  "editor.formatOnSave": true,
  "eslint.enable": true,
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "always"
  },
  "peacock.color": "#4913beffff",
  "jest.runMode": {
    "type": "on-demand"
  },
  "files.associations": {
    "**/templates/**": "typescript"
  }
}