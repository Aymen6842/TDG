  Returned
  Failed
  Processing
}

enum PagePaletteName {
    LandingPage
}

Enum PromotionType {
  percentage
  amount
}

Enum VoucherCodeDiscountType {
  percentage
  amount
}

//////////////////////////////////////////////////////
// RELATIONS
//////////////////////////////////////////////////////
Ref: UserPoints.userId > User.id
Ref: Role.userId > User.id
Ref: RefreshToken.userId > User.id
Ref: ResetPasswordCode.userId > User.id

Ref: CountryContent.isoCode > Country.isoCode
Ref: City.isoCode > Country.isoCode
Ref: CityContent.cityId > City.id
Ref: Address.cityId > City.id
Ref: Address.userId > User.id
Ref: ShippingCost.cityId > City.id

Ref: BrandContent.brandId > Brand.id
Ref: BrandMetaContent.brandId > Brand.id

Ref: Category.parentCategoryId > Category.id
Ref: CategoryContent.categoryId > Category.id
Ref: CategoryMetaContent.categoryId > Category.id
Ref: ProductOnCategory.categoryId > Category.id
Ref: ProductOnCategory.productId > Product.id

Ref: ProductContent.productId > Product.id
Ref: ProductMetaContent.productId > Product.id
Ref: ProductItem.productId > Product.id
Ref: ProductItemVariation.productItemId > ProductItem.id
Ref: ProductItemVariationContent.productItemVariationId > ProductItemVariation.id
Ref: ProductItemPrice.productItemId > ProductItem.id
Ref: ProductItemImage.productItemId > ProductItem.id
Ref: ProductItemInventory.productItemId > ProductItem.id
Ref: Product.brandId > Brand.id

Ref: Order.addressId > Address.id // Order linked to shipping address
Ref: OrderItem.orderId > Order.id // Each order item belongs to one order
Ref: OrderItem.productItemId > ProductItem.id // Each order item links to a product item
Ref: OrderItemContent.orderItemId > OrderItem.id // Item name translations
Ref: VoucherCodeUsedInOrder.orderId > Order.id // Voucher used at order level
Ref: VoucherCodeUsedInOrder.orderItemId > OrderItem.id // Voucher used at item level
Ref: VoucherCodeDiscountUsedInOrder.voucherCodeId > VoucherCodeUsedInOrder.id // Discount applied by voucher
Ref: PromotionUsedInOrder.orderItemId > OrderItem.id // Promotion applied to order item
Ref: PromotionContentUsedInOrder.promotionId > PromotionUsedInOrder.id // Promotion name translations
Ref: PromotionDiscountUsedInOrder.promotionId > PromotionUsedInOrder.id // Promotion discount applied
Ref: VoucherCodeUsedInOrder.promotionDiscountUsedInOrderId > PromotionDiscountUsedInOrder.id // Voucher linked to promotion discount

Ref: PagePaletteMetaContent.pagePaletteId > PagePalette.id // Meta content belongs to a palette
Ref: PagePaletteImage.pagePaletteId > PagePalette.id // Images belong to a palette
Ref: PagePaletteSection.pagePaletteId > PagePalette.id // Sections belong to a palette
Ref: PagePaletteSectionContent.pagePaletteSectionId > PagePaletteSection.id // Section content belongs to a section

Ref: PromotionContent.promotionId > Promotion.id // Content belongs to a promotion
Ref: ProductItemPromotion.promotionId > Promotion.id // Product item linked to promotion
Ref: ProductItemPromotion.productItemId > ProductItem.id // Product item linked to promotion

Ref: ShoppingCartItem.shoppingCartId > ShoppingCart.id // Items belong to a shopping cart
Ref: ShoppingCartItem.productItemId > ProductItem.id // Items link to product items

Ref: UserFavourite.userId > User.id // Favourite belongs to a user
Ref: UserFavourite.productItemId > ProductItem.id // Favourite links to a product item

Ref: VoucherCodePeriod.voucherCodeId > VoucherCode.id
Ref: VoucherCodeDiscount.voucherCodeId > VoucherCode.id
Ref: VoucherCodeProductItem.voucherCodeId > VoucherCode.id
Ref: VoucherCodeProductItem.productItemId > ProductItem.id
Ref: VoucherCodeProductItemDiscount.voucherCodeProductItemId > VoucherCodeProductItem.id
Ref: VoucherCodeBrand.voucherCodeId > VoucherCode.id
Ref: VoucherCodeBrand.brandId > Brand.id
Ref: VoucherCodeBrandDiscount.voucherCodeBrandId > VoucherCodeBrand.id
Ref: VoucherCodeCategory.voucherCodeId > VoucherCode.id
Ref: VoucherCodeCategory.categoryId > Category.id
Ref: VoucherCodeCategoryDiscount.voucherCodeCategoryId > VoucherCodeCategory.id
Ref: VoucherCode.generatedById > User.id
Ref: Notification.userId > User.id